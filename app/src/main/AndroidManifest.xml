<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 路由器管理走内网 http(s) 直连；Android 9+ 默认禁明文，此 app 的首要场景即 http://192.168.x.1，显式放行 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- NetBinder 枚举在册网络与链路地址：无互联网 WiFi 的私网目标需显式 bindProcessToNetwork -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 16 LNP：targetSdk≥36 访问局域网（192.168.x.x 等）必须持有「附近的设备」权限，
         过渡期挂靠 NEARBY_WIFI_DEVICES，未授权时 SYN 被静默黑洞（连接超时） -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" />
    <!-- 应用内更新：下载 APK 后经系统安装器安装，「安装未知应用」授权由系统面板引导 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 云备份只含设备地址/用户名/凭据密文与崩溃堆栈——数据最小化，整体禁用
         （Keystore 密钥本就不迁移，恢复后密文必然解密失败清空） -->
    <application
        android:name=".WrtApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.WrtCtrl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- per-app language：Android 12 及以下由 appcompat 回退实现，此服务开启语言选择持久化 -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!-- 应用内更新：仅向系统安装器暴露 cache/updates 下的安装包 -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
